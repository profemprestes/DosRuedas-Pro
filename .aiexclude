# Node.js y dependencias (Exclusión de binarios y módulos pesados)
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log

# Compilaciones y artefactos de Next.js (Mejora de la ventana de contexto)
.next/
out/
build/
dist/
.turbo/

# Archivos de entorno y secretos (Prevenir filtraciones de credenciales)
.env
.env*.local
.env.development
.env.production
.env.test

# Logs generados por la aplicación y reportes
*.log
logs/

# Archivos binarios y multimedia (Bloqueados por ineficiencia de parseo en texto)
*.pdf
*.mp4
*.zip
*.tar.gz
*.jpg
*.jpeg
*.png
*.gif
*.ico
*.svg
*.webp

# Configuración del IDE, OS y metadatos locales
.vscode/
.idea/
.DS_Store
Thumbs.db

# Lockfiles gigantes (Saturan la ventana de contexto innecesariamente)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Genkit / AI local states (Evitar recursividad en los flujos de IA)
.genkit/
