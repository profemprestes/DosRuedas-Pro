# Bloqueo de directorios de construcción y dependencias
.next/
node_modules/
dist/
build/
out/

# Ignorar archivos de entorno y secretos
.env*
*.local
.firebase/
apphosting.yaml

# Excluir binarios e imágenes pesadas para liberar contexto
public/*.webp
public/*.png
public/*.jpg
public/*.ico

# Logs y trazas de ejecución
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Documentación de referencia pesada (mantener solo src)
docs/ejemplos/
all_pages.txt
all_pages_full.txt

# Scripts de utilería (Python/JS de limpieza)
fix_*.py
update_*.py
test_*.py
screenshot_*.js
